PRODUCT_BUNDLE_IDENTIFIER = uk.co.thomascarter.TomsTrains
PRODUCT_NAME = TomsTrains
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Tom's Trains
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.travel
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Set your signing team in Xcode, or in the untracked Local.xcconfig.
#include? "Local.xcconfig"

#include? "API.xcconfig"
